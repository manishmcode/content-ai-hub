Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# ==========================================
# 5. SIGNED ASSET ROUTING
# ==========================================

# Rewrite /v/TOKEN internally to the existing Passenger Node.js application.
# Browser URL remains /v/TOKEN.
# This requires Passenger to accept internally rewritten requests.
RewriteRule ^v/(.+)$ /content-aihub-api/v/$1 [L,NC,NE]

# Keep the SPA's designed 404 screen while preserving an actual HTTP 404
# response for invalid URLs. Apache internally serves index.html; the browser
# keeps the original URL, so React Router renders its catch-all NotFoundPage.
ErrorDocument 404 /index.html

# Public API: https://contentaihub.net/content-aihub-api
# Keep API requests out of the React SPA fallback. The web server / Node app
# must serve this path directly.
RewriteRule ^content-aihub-api(?:/|$) - [L]

# Let Apache serve real files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Known React routes may be served by the SPA fallback. Keep this list in sync
# with src/App.tsx; anything else is a genuine missing URL.
RewriteRule ^(?:|library/?|pricing/?|unsubscribe/?|login/?|logout/?|signup/?|my-account/?|privacy-policy/?|terms-conditions/?|imprint/?|account/?|dashboard/?|my-courses/?|live-classes/?|courses/?|courses/[^/]+/?|checkout/?|terms/?|privacy/?)$ index.html [L]

# Invalid URLs, including /404/, must be HTTP 404s in the network response.
RewriteRule ^ - [R=404,L]
